# M-TUBE environment variables
# Copy this file to .env.local for development. Never commit real values.

# Some YouTube links require a valid server-side cookie for the downloader.
MTUBE_YOUTUBE_COOKIE=
MTUBE_YOUTUBE_MAX_DURATION=1800

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Support links
NEXT_PUBLIC_SUPPORT_FACEBOOK=
NEXT_PUBLIC_SUPPORT_TELEGRAM=
NEXT_PUBLIC_SUPPORT_DISCORD=
NEXT_PUBLIC_SUPPORT_YOUTUBE=